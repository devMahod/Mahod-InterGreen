<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packaging support project (productization directive §6). It wraps the ALREADY
       VALIDATED dist/ bundle; it never builds or references engineering assemblies. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mahod_Intergreen_Setup_0.1.0-r4</AssemblyName>
    <Product>Mahod Intergreen</Product>
    <Company>Mahod Engineering</Company>
    <AssemblyTitle>Mahod Intergreen Setup</AssemblyTitle>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0 installer r2 (runtime-closure fix: +SixLabors.Fonts, +RBush; engine binaries unchanged)</InformationalVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtraction>true</IncludeNativeLibrariesForSelfExtraction>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload\bundle.zip" />
  </ItemGroup>

</Project>
