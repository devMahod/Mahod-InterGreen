<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packaging support project. It wraps the ALREADY VALIDATED dist/ bundle; it never
       builds or references engineering assemblies. All shipped version metadata comes
       from the single source of truth below (never hand-typed here). -->
  <Import Project="..\..\build\MahodRelease.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mahod_Intergreen_Setup_$(MahodEngineVersion)-$(MahodReleaseRevision)</AssemblyName>
    <AssemblyTitle>Mahod Intergreen Setup</AssemblyTitle>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtraction>true</IncludeNativeLibrariesForSelfExtraction>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MahodHostBuilds" Value="2026;2027" />
    <AssemblyMetadata Include="MahodArtifactKind" Value="UniversalInstaller" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload\bundle.zip" />
  </ItemGroup>

</Project>
