<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\MahodRelease.props" />
  <!-- r15: Mahod Impact usage key, baked from MAHOD_CAD_KEY at build time only (public repo: never commit a keyed build) -->
  <Import Project="..\..\build\MahodUsageKey.targets" />

  <!-- ONE host codebase, version-correct builds (Multi-Host directive §4/§5):
         dotnet build -p:AutoCADVersion=2026  -> net8.0-windows  + Autodesk 2026 refs
         dotnet build -p:AutoCADVersion=2027  -> net10.0-windows + Autodesk 2027 refs
       The same year build serves AutoCAD and Civil 3D of that year (§6).
       Autodesk assemblies are referenced from the local installation and are NEVER
       copied or shipped. Output assembly is host-neutral: Mahod.Intergreen.AutoCAD. -->
  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2026</AutoCADVersion>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2027'">net10.0-windows</TargetFramework>
    <AssemblyName>Mahod.Intergreen.AutoCAD</AssemblyName>
    <RootNamespace>Mahod.Intergreen.AutoCAD2026</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWPF>true</UseWPF>
    <AutoCadDir>C:\Program Files\Autodesk\AutoCAD $(AutoCADVersion)</AutoCadDir>
    <DefineConstants>$(DefineConstants);ACADHOST$(AutoCADVersion)</DefineConstants>
    <BaseOutputPath>bin\host$(AutoCADVersion)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\host$(AutoCADVersion)\</BaseIntermediateOutputPath>
    <!-- r15: this project compiles Usage/MahodUsage.cs, so it takes the products' usage key (build/MahodUsageKey.targets) -->
    <MahodUsageKeyed>true</MahodUsageKeyed>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MahodHostBuild" Value="$(AutoCADVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <InformationalVersion>$(InformationalVersion), host build $(AutoCADVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mahod.Intergreen.Contracts\Mahod.Intergreen.Contracts.csproj" />
    <ProjectReference Include="..\Mahod.Intergreen.Core\Mahod.Intergreen.Core.csproj" />
    <ProjectReference Include="..\Mahod.Intergreen.Geometry\Mahod.Intergreen.Geometry.csproj" />
    <ProjectReference Include="..\Mahod.Intergreen.Rules\Mahod.Intergreen.Rules.csproj" />
    <ProjectReference Include="..\Mahod.Intergreen.Reporting\Mahod.Intergreen.Reporting.csproj" />
    <ProjectReference Include="..\Mahod.Intergreen.Host\Mahod.Intergreen.Host.csproj" />
    <ProjectReference Include="..\Mahod.Intergreen.Excel\Mahod.Intergreen.Excel.csproj" />
  </ItemGroup>

  <!-- Guard against wrong-year Autodesk resolution: fail the build if the pinned
       reference directory does not match the requested AutoCADVersion. -->
  <Target Name="VerifyAutodeskYear" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AutoCadDir)\acdbmgd.dll')"
           Text="Autodesk $(AutoCADVersion) managed references not found at $(AutoCadDir)" />
  </Target>

  <ItemGroup>
    <!-- Official Mahod logo (white variant) — shipped inside the assembly so the palette
         never depends on any user folder at runtime. -->
    <EmbeddedResource Include="Resources\MahodLogoWhite.png" />
  </ItemGroup>
</Project>
